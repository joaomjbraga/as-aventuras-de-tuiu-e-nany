{
  // ---------------------------------------------------------------------
  // Política de nome dos artefatos
  //
  // O nome é por plataforma e NÃO leva ${version}. Isso é o que permite a
  // vitrine em doc/ apontar direto para o arquivo: o GitHub só tem um alias
  // de última versão na URL, releases/latest/download/<arquivo>. Ele
  // resolve qual é a release mais recente, mas ainda exige que o arquivo se
  // chame exatamente aquilo. Com a versão no nome, cada release renomearia o
  // artefato e o link da vitrine passaria a apontar para um arquivo que já
  // não existe.
  //
  // ${name} em vez de ${productName} porque o padrão geraria "As Aventuras de
  // Tuiu e Nany.exe", com espaços, que na URL de download direto vira
  // percent-encoded. ${name} é o slug do package.json.
  //
  // O padrão fica por plataforma, e não na raiz, porque os dois nomes
  // precisam ser distinguíveis entre si. A resolução do electron-builder é
  // "artifactName do target → artifactName da plataforma → artifactName da
  // raiz" e nenhum target aqui declara o seu, então a plataforma é o nível
  // que vale.
  //
  // Repetir o mesmo nome entre versões não atrapalha: cada tag tem seu
  // próprio conjunto de arquivos.
  // ---------------------------------------------------------------------

  appId: 'br.com.joaomjbraga.asaventurasdetuiue_nany',
  productName: 'As Aventuras de Tuiu e Nany',
  copyright: 'Copyright © 2026 João M J Braga',
  asar: true,
  compression: 'maximum',
  npmRebuild: false,
  publish: null,

  directories: {
    output: 'release',
    buildResources: 'public',
  },

  files: ['out/**/*', 'package.json', '!**/*.map'],

  // Windows: só o executável portátil, sem instalador. O .exe roda direto da
  // pasta onde o usuário salvar.
  //
  // Sem seção `nsis` aqui de propósito: o target portátil não herda dela
  // (as PortableOptions não têm oneClick/perMachine/shortcutName) e o
  // template portable.nsi só extrai, executa e limpa — não existe atalho de
  // área de trabalho nem de menu Iniciar para configurar.
  win: {
    artifactName: '${name}-windows.${ext}',
    target: [{ target: 'portable', arch: ['x64'] }],
    icon: 'public/icon.ico',
  },

  // Linux: AppImage, que também é portátil (roda da pasta, sem instalar).
  linux: {
    artifactName: '${name}-linux.${ext}',
    target: [{ target: 'AppImage', arch: ['x64'] }],
    category: 'Game',
    icon: 'public/Icon.png',
    syncDesktopName: true,
  },
}
