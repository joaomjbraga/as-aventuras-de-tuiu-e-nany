    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "electron@44.4.4": true,
    "esbuild@0.25.12": true
